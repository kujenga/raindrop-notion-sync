# Raindrop.io API access token (Test Token or OAuth token).
# Create an app at https://app.raindrop.io/settings/integrations and copy the "Test token".
# Set in the worker with: ntn workers env set RAINDROP_TOKEN=...
RAINDROP_TOKEN=

# Optional: which Raindrop collection to sync.
#   0   = all bookmarks across every collection (default)
#  -1   = unsorted
#  <id> = a specific collection id
# Each synced page is labelled with its source collection regardless of this.
RAINDROP_COLLECTION_ID=0

# (Tags/Collection select options are NOT env vars — `bun run refresh-options`
# generates them into src/raindrop-options.ts, compiled into the deploy bundle.)

# Optional: sync the full cleaned article body onto each Notion page.
# When enabled, the worker fetches each bookmark's Raindrop "permanent copy"
# (Pro) and uses Gemini to render a clean Markdown article in the page body.
# Requires GEMINI_API_KEY. Leave unset/0 to sync metadata + notes/highlights only.
SYNC_CONTENT=0

# Google Gemini API key, used only when SYNC_CONTENT is enabled.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the sync schedules. Accepts "continuous", "manual", or an
# interval like "30m", "6h", "1d". Takes effect on the next deploy.
#  FULL_SYNC_SCHEDULE         full mirror + deletions; runs in replace mode
#                             (re-mirrors the whole library each run), so make
#                             it LESS frequent for large libraries. Default 1d.
#  INCREMENTAL_SYNC_SCHEDULE  cheap pickup of new/changed bookmarks (and article
#                             bodies when SYNC_CONTENT=1). Default 1h.
# FULL_SYNC_SCHEDULE=1d
# INCREMENTAL_SYNC_SCHEDULE=1h
